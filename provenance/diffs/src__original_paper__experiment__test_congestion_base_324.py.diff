+    def _calculate_congestion_coverage(self, path, times=None) -> dict:
+        """
+        计算路径与拥堵区域的详细覆盖情况，返回拥堵覆盖率
+        """
+        if not self.congestion_zones or not path:
+            print("congestion_zones不存在")
+            return {
+                'passes_congestion': False,
+                'congestion_point_count': 0,
+                'total_path_points': len(path) if path else 0,
+                'congestion_coverage_ratio': 0.0,
+                'congestion_coverage_path': 0.0,
+                'congestion_coverage_area':0.0,
+            }
+
+        congestion_positions = set((x, y, slot) for (x, y, slot), _ in self.congestion_zones)
+
+        congestion_point_count = 0
+        total_path_points = len(path)
+
+        for i, (x, y) in enumerate(path):
+            if times is None or i >= len(times):
+                slot = 0
+            else:
+                slot = int(times[i] // DELTA)
+
+            if (x, y, slot) in congestion_positions:
+                congestion_point_count += 1
+
+        congestion_coverage_ratio = congestion_point_count / max(total_path_points, 1)
+        congestion_coverage_percentage_path = f"{100 * congestion_coverage_ratio:.1f}%"
+        congestion_coverage_percentage_area = f"{100 * (congestion_point_count / max(len(congestion_positions), 1)):.1f}%"
+        passes_congestion = congestion_point_count > 0
+
+        return {
+            'passes_congestion': passes_congestion,
+            'congestion_point_count': congestion_point_count,
+            'total_path_points': total_path_points,
+            'congestion_coverage_ratio':congestion_coverage_ratio,
+            'congestion_coverage_path': congestion_coverage_percentage_path, #路径中多少进入congestion
+            'congestion_coverage_area': congestion_coverage_percentage_area  # 占冲突区域的百分比
+        }
+
+    def _calculate_detour_ratio(self, path: List[Tuple]) -> float:
+        """
+        计算绕路系数
+        绮路系数 = 实际路径长 / 欧式距离
+        """
+        if len(path) < 2:
+            return 1.0
+
+        actual_length = len(path) - 1
+        euclidean_distance = np.sqrt((path[0][0] - path[-1][0]) ** 2 + (path[0][1] - path[-1][1]) ** 2)
+
+        return actual_length / max(euclidean_distance, 1.0)
+
+    def _count_turns(self, path: List[Tuple]) -> int:
+        """计算路径的转弯次数"""
+        if len(path) < 3:
+            return 0
+
+        turns = 0
+        prev_dx = path[1][0] - path[0][0]
+        prev_dy = path[1][1] - path[0][1]
+
+        for i in range(2, len(path)):
+            curr_dx = path[i][0] - path[i - 1][0]
+            curr_dy = path[i][1] - path[i - 1][1]
+
+            if (curr_dx, curr_dy) != (prev_dx, prev_dy):
+                turns += 1
+
+            prev_dx, prev_dy = curr_dx, curr_dy
+
+        return turns
+
