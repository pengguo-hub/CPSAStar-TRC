-    def _find_blocker(self, failed_agv_id, failed_priority, committed_agvs, dynamic_priorities):
-        """
-        从「未固化」AGV 里，找出在 failed_agv 的路径上有节点冲突、
-        且优先级 >= failed_priority 的 AGV，返回冲突最多的那个。
-        """
-        waypoint_set = set(self.agv_tasks[failed_agv_id]['waypoints'])  # 只关心这些点
-        candidate_blockers = {}  # {agv_id: conflict_count}
-        # 只看：有预约、未 committed、不是自己 的 AGV
-        for agv_id, reservations in self.ticket_manager.agv_reservations.items():
-            if agv_id == failed_agv_id or agv_id in committed_agvs:
-                continue
-            # 优先级比 failed_agv 低的，直接跳过
-            current_agv_prio = dynamic_priorities.get(agv_id, 0.0)
-            if current_agv_prio < failed_priority:
-                continue
-            conflict_count = 0
-
-            for key in reservations:
-                # 这里只关心节点预约 (node, t)，忽略 edge 预约
-                if isinstance(key, tuple) and len(key) == 2:
-                    node, t = key
-                    if node in waypoint_set:
-                        conflict_count += 1
-
-            if conflict_count > 0:
-                candidate_blockers[agv_id] = conflict_count
-
-        if not candidate_blockers:
-            return None
-
-        # 冲突点最多的那个 AGV 作为 blocker
-        return max(candidate_blockers, key=candidate_blockers.get)
