+            return
+
+        fig, ax = plt.subplots(figsize=(14, 10))
+
+        # 绘制网格背景
+        im = ax.imshow(self.grid, cmap=self.custom_cmap, norm=self.norm, alpha=0.6, origin='lower',
+                       extent=(0, self.grid_size[0], 0, self.grid_size[1]))
+
+        # === 绘制特殊区域边框 ===
+        for (x, y) in self.shelf_cells:
