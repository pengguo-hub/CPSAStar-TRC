+    def load_paths(self, json_file="paths.json"):
+        """从 JSON 文件加载路径数据"""
+        try:
+            with open(json_file, 'r', encoding='utf-8') as f:
+                paths = json.load(f)
+            print(f"成功加载路径文件: {json_file}")
+            return paths
+        except FileNotFoundError:
+            print(f"未找到路径文件: {json_file}")
+            return {}
+        except json.JSONDecodeError as e:
+            print(f"JSON 解析错误: {e}")
+            return {}
+
+    def detect_conflicts(self, paths, time_step):
+        """检测在指定时间步的点冲突和边冲突，忽略已到达终点的 AGV"""
+        conflicts = []
+        positions_at_time = {}  # 用于检测点冲突
+        edges_this_step = {}  # 用于检测边冲突 (x1,y1,x2,y2) -> agv_id
+
+        # 获取所有 AGV 的终点
+        endpoints = {agv_id: tuple(path[-1]) for agv_id, path in paths.items() if path}
+
+        for agv_id, path in paths.items():
+            if not path:
+                continue
+
+            # 如果当前时间步超出路径长度，AGV 停留在最后一个位置（即终点）
+            if time_step >= len(path):
+                current_pos = tuple(path[-1])
+                is_at_final = True
+            else:
+                current_pos = tuple(path[time_step])
+                is_at_final = (current_pos == endpoints[agv_id])
+
+            # === 关键：如果 AGV 已到达终点，则不再参与任何冲突检测 ===
+            if is_at_final:
+                continue  # 跳过该 AGV
+
+            # === 1. 点冲突检测 ===
+            if current_pos in positions_at_time:
+                conflict_key = ('node', current_pos)
+                if conflict_key not in conflicts:
+                    conflicts.append(conflict_key)
+            else:
+                positions_at_time[current_pos] = agv_id
+
+            # === 2. 边冲突检测：仅当 AGV 正在移动时才检测 ===
+            if time_step < len(path) - 1:
+                next_pos = tuple(path[time_step + 1])
+                x1, y1 = current_pos
+                x2, y2 = next_pos
+                if abs(x1 - x2) + abs(y1 - y2) == 1:  # 四邻域移动
+                    forward_edge = (x1, y1, x2, y2)
+                    backward_edge = (x2, y2, x1, y1)
+                    if backward_edge in edges_this_step:
+                        conflict_key = ('edge', (x1, y1), (x2, y2), time_step)
+                        if conflict_key not in conflicts:
+                            conflicts.append(conflict_key)
+                    else:
+                        edges_this_step[forward_edge] = agv_id
+
+        return conflicts
+
+    def calculate_statistics(self, paths):
+        """计算路径统计信息"""
+        stats = {
+            'total_agvs': len(paths),
+            'total_distance': sum(len(path) for path in paths.values()),
+            'max_path_length': max(len(path) for path in paths.values()) if paths else 0,
+            'min_path_length': min(len(path) for path in paths.values()) if paths else 0,
+            'avg_path_length': sum(len(path) for path in paths.values()) / len(paths) if paths else 0
+        }
+        return stats
+
+    def visualize_static(self, paths, save_filename="static_paths.png", draw_shelf_markers=False):
+        """静态可视化所有路径"""
+        fig, ax = plt.subplots(figsize=(10, 10))
