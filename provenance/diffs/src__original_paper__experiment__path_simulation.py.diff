+                # ax.plot(x_coords[-1], y_coords[-1], color=colors[i], marker='^',
+                #         markersize=8, markeredgecolor='black')
+                # 用圆形画路径点，圆的直径=1，也就是半径0.5
+                for (x, y) in path:
+                    circle = patches.Circle((x + 0.5, y + 0.5), radius=0.5, edgecolor=colors[i],
+                                            facecolor='none', linewidth=2)
+                    ax.add_patch(circle)
+
+            # 设置坐标轴
+        ax.set_xlim(0, self.grid_size[0])
+        ax.set_ylim(0, self.grid_size[1])
+        # ax.set_xticks(range(0, self.grid_size[0]+1))
+        # ax.set_yticks(range(0, self.grid_size[1]+1))
+        xticks = [0,5,10,15]
+        yticks = [0,5,10]
+        ax.set_xticks(xticks)
+        ax.set_yticks(yticks)
+        ax.tick_params(axis='x', labelsize=16)  # 设置X轴刻度字体大小 (14可改)
+        ax.tick_params(axis='y', labelsize=16)  # 设置Y轴刻度字体大小 (14可改)
+        ax.minorticks_on()
+        # ax.set_xlabel('X Coordinate', fontsize=16)
+        # ax.set_ylabel('Y Coordinate', fontsize=16)
+        # ax.set_title('AGV Path Planning Visualization')
+
+        # 使用 tick_params 隐藏“标签”和“刻度线”，但保留网格所需的位置信息
