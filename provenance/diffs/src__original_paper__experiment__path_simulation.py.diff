+            # 2. 如果需要，绘制四周的菱形标记
+            if draw_shelf_markers:
+                # 定义菱形颜色
+                diamond_face_color = '#83B8F5'
+                diamond_edge_color = '#324EBA'  # 边框
+                directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # 上下左右偏移
+                # 菱形的大小控制 (从中心到顶点的距离)
+                # 格子边长是1，半径设为 0.35 可以保证菱形在格子内且不碰到边界
+                diamond_radius = 0.25
+                for dx, dy in directions:
+                    nx, ny = x + dx, y + dy
+
+                    # 检查相邻格子是否在地图范围内
+                    if 0 <= nx < self.grid_size[0] and 0 <= ny < self.grid_size[1]:
+                        # 格子中心坐标
+                        cx, cy = nx + 0.5, ny + 0.5
+
+                        # 手动计算菱形的四个顶点 (上, 右, 下, 左)
+                        # 这样能确保绝对是菱形，而不是旋转的正方形可能出现的显示问题
+                        pts = [
+                            (cx, cy + diamond_radius),  # 上
+                            (cx + diamond_radius, cy),  # 右
+                            (cx, cy - diamond_radius),  # 下
+                            (cx - diamond_radius, cy)  # 左
+                        ]
+
+                        # 创建多边形 (菱形)
+                        diamond = patches.Polygon(
+                            pts,
+                            closed=True,
+                            facecolor=diamond_face_color,
+                            edgecolor=diamond_edge_color,
+                            linewidth=1.5,
+                            alpha=0.8
+                        )
+                        ax.add_patch(diamond)
+
+        for (x, y) in self.outbound_cells:
+            rect = Rectangle((x , y ), 1, 1, linewidth=1.2, edgecolor='#7B379E',
+                             facecolor='none', linestyle='-')
+            ax.add_patch(rect)
+        # ================================
+        # 绘制路径
+        colors = sns.color_palette("husl", len(paths))
+        for i, (agv_id, path) in enumerate(paths.items()):
+            if path:
+                # 画路径连线，不画路径点plot
+                x_coords = [pt[0]+0.5 for pt in path]
+                y_coords = [pt[1]+0.5 for pt in path]
+                ax.plot(x_coords, y_coords, color=colors[i], linewidth=2,
+                        marker='o', markersize=3, label=f'AGV {agv_id}')
+
+                # 标记起点和终点
+                # ax.plot(x_coords[0], y_coords[0], color=colors[i], marker='s',
