+        # === 绘制特殊区域的边框 ===
+
+        # === 新增：绘制特殊区域的彩色边框 ===
+        for (x, y) in self.shelf_cells:
+            rect = Rectangle((x , y ), 1, 1, linewidth=1.2, edgecolor='black',
+                             facecolor='none', linestyle='-')
